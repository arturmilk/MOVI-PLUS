[Unit]
Description=NOVAGENTE Clube do Motorista V5 - Integridade e backup
After=novagente-clube-motorista-v5.service
[Service]
Type=oneshot
User=sentinelx
Group=sentinelx
WorkingDirectory=/srv/clube-motorista-v3/financeiro-secure-v5
ExecStart=/srv/clube-motorista-v3/financeiro-secure-v5/.venv/bin/python healthcheck_stage3.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/clube-motorista-v3/financeiro-secure-v5/data
UMask=0077
